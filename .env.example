NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=

AUTH_SECRET=
DASHBOARD_PASSWORD=
API_SECRET=

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_USER_ID=
# Optional — grants a second Telegram sender the same bot access as
# TELEGRAM_USER_ID, acting on the same shared data (not a separate
# sandbox). Unset to revoke; takes effect on the next webhook request,
# no code change needed (Vercel env var changes need a redeploy to reach
# production, but nothing else).
TESTER_TELEGRAM_USER_ID=

CRON_SECRET=
USER_TIMEZONE=America/New_York
USER_ID=kody

# Optional — rate calculator mileage lookup falls back to free OSRM +
# Nominatim (no key) when this is unset.
GOOGLE_MAPS_API_KEY=

# Required for the automated PPG (fuel price) feature. Free key from
# eia.gov/opendata. Without it, the fuel-price cron logs a clear error
# and rate quotes fall back to a saved/fixed PPG as before.
EIA_API_KEY=
